fakenewsai.info, www.fakenewsai.info {
    encode gzip

    reverse_proxy localhost:8000

    handle_path /static/* {
        root * /home/alejandro/github/agbaltazar/Fake-News-Spotter/frontend
        file_server
    }

    handle {
        root * /home/alejandro/github/agbaltazar/Fake-News-Spotter/frontend
        file_server
        try_files {path} /index.html
    }

    log {
        output file /var/log/caddy/fakenewsai-access.log
    }
}
